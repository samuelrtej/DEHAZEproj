<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Image Enhancer</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .image-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            margin-top: 15px;
        }
        .image-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        canvas, img {
            border-radius: 12px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
            max-width: 100%;
            height: auto;
        }
        .label {
            font-size: 15px;
            font-weight: bold;
            color: #fff;
            margin-top: 5px;
        }
        .download-btn {
            margin-top: 8px;
        }
        .generated-label {
            color: #4ade80; /* Green color for the Generated image text */
        }
    </style>
</head>
<body>
    <div class="bg-white p-6 rounded-lg shadow-xl max-w-lg w-full text-center">
        <h2 class="text-3xl font-bold text-gray-700 mb-4">Advanced Image Enhancer</h2>
        <p class="text-gray-500 mb-2">Upload your image and apply enhancements</p>
        <input type="file" id="imageInput" accept="image/*" multiple class="w-full p-2 border rounded mb-4">
        <div class="flex flex-wrap justify-center gap-2 mb-4">
            <button onclick="dehazeImages()" class="bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600">Dehaze</button>
            <button onclick="enhanceContrast()" class="bg-green-500 text-white py-2 px-4 rounded hover:bg-green-600">Enhance Contrast</button>
            <button onclick="sharpenImage()" class="bg-yellow-500 text-white py-2 px-4 rounded hover:bg-yellow-600">Sharpen</button>
        </div>
        <div class="image-container" id="imageContainer"></div>
    </div>

    <script>
        function processImages(effectFunction) {
            const input = document.getElementById('imageInput');
            const imageContainer = document.getElementById('imageContainer');
            imageContainer.innerHTML = '';

            if (input.files.length > 0) {
                Array.from(input.files).slice(0, 4).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = new Image();
                        img.onload = function () {
                            const wrapper = document.createElement('div');
                            wrapper.classList.add('image-wrapper');

                            const original = document.createElement('img');
                            original.src = e.target.result;
                            original.alt = 'Original Image';
                            const originalLabel = document.createElement('p');
                            originalLabel.classList.add('label');
                            originalLabel.textContent = 'Original';

                            const canvas = document.createElement('canvas');
                            const ctx = canvas.getContext('2d');
                            canvas.width = img.width;
                            canvas.height = img.height;
                            ctx.drawImage(img, 0, 0);
                            effectFunction(ctx, img.width, img.height);

                            const processedLabel = document.createElement('p');
                            processedLabel.classList.add('label');
                            processedLabel.textContent = 'Enhanced';

                            // Add download button for enhanced image
                            const downloadBtn = document.createElement('a');
                            downloadBtn.classList.add('bg-purple-500', 'text-white', 'py-1', 'px-3', 'rounded', 'hover:bg-purple-600', 'download-btn');
                            downloadBtn.textContent = 'Download Enhanced';
                            downloadBtn.href = canvas.toDataURL('image/png');
                            downloadBtn.download = 'enhanced_' + file.name;

                            wrapper.appendChild(original);
                            wrapper.appendChild(originalLabel);
                            wrapper.appendChild(canvas);
                            wrapper.appendChild(processedLabel);
                            wrapper.appendChild(downloadBtn);
                            imageContainer.appendChild(wrapper);
                        };
                        img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                });
            }
        }

        function dehazeImages() {
            processImages((ctx, width, height) => {
                const imageData = ctx.getImageData(0, 0, width, height);
                const data = imageData.data;
                for (let i = 0; i < data.length; i += 4) {
                    data[i] = Math.min(data[i] * 1.2, 255);
                    data[i + 1] = Math.min(data[i + 1] * 1.2, 255);
                    data[i + 2] = Math.min(data[i + 2] * 1.2, 255);
                }
                ctx.putImageData(imageData, 0, 0);
            });
        }

        function enhanceContrast() {
            processImages((ctx, width, height) => {
                const imageData = ctx.getImageData(0, 0, width, height);
                const data = imageData.data;
                const contrast = 1.3;
                for (let i = 0; i < data.length; i += 4) {
                    data[i] = Math.min((data[i] - 128) * contrast + 128, 255);
                    data[i + 1] = Math.min((data[i + 1] - 128) * contrast + 128, 255);
                    data[i + 2] = Math.min((data[i + 2] - 128) * contrast + 128, 255);
                }
                ctx.putImageData(imageData, 0, 0);
            });
        }

        function sharpenImage() {
            processImages((ctx, width, height) => {
                const imageData = ctx.getImageData(0, 0, width, height);
                const data = imageData.data;
                for (let i = 0; i < data.length; i += 4) {
                    data[i] = Math.min(data[i] * 1.5, 255);
                    data[i + 1] = Math.min(data[i + 1] * 1.5, 255);
                    data[i + 2] = Math.min(data[i + 2] * 1.5, 255);
                }
                ctx.putImageData(imageData, 0, 0);
            });
        }
    </script>
</body>
</html>
